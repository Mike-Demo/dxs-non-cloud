# DXS Non-Cloud — environment template
# This build runs on the mock data layer and currently reads no secrets
# and no required environment variables.
# VITE_DATA_MODE is the planned explicit override named in
# src/lib/data/client.ts (it takes effect once a cloud adapter exists);
# it is shown here for parity with the cloud variant (info-grove).
# Never commit real credentials — .env is gitignored.

VITE_DATA_MODE=mock
